  },
  {
   "tipo": "versiculo",
   "inicio": 39.81,
   "fin": 51.95,
   "cita": "Daniel 10:13 · Reina-Valera 1960",
   "version": false,
   "versiculo": "Mas el príncipe del reino de Persia se me opuso durante *veintiún días*; pero he aquí *Miguel*, uno de los principales príncipes, vino para ayudarme, y quedé allí con los reyes de Persia.",
   "tInicio": 0.4,
   "tEscritura": 11.4
  },
